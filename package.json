{
  "name": "bricklap",
  "private": true,
  "version": "0.1.0",
  "description": "Bricklap — start once, train freely. Monorepo: engine, web lab, Android app.",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev --workspace @bricklap/web-lab",
    "build:web": "npm run build --workspace @bricklap/web-lab",
    "dev:mobile": "npm run start --workspace @bricklap/mobile",
    "android": "npm run android --workspace @bricklap/mobile"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.0.0"
  }
}
