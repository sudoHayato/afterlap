{
  "name": "@bricklap/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Bricklap shared translation dictionaries (en base, pt-PT first translation) and a metric/imperial unit-formatting layer. Pure TypeScript, no platform APIs.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bricklap/engine": "*"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
